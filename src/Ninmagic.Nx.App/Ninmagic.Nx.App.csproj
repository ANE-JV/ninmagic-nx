<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>ninmagic-nx</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/ninmagic-logo.jpg" />
    <ProjectReference Include="../Ninmagic.Nx.Core/Ninmagic.Nx.Core.csproj" />
    <ProjectReference Include="../Ninmagic.Nx.Windows/Ninmagic.Nx.Windows.csproj" />
    <ProjectReference Include="../Ninmagic.Nx.Updates/Ninmagic.Nx.Updates.csproj" />
  </ItemGroup>
</Project>
