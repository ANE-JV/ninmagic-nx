<Window x:Class="Ninmagic.Nx.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ninmagic-nx · Migrador de microSD" Width="1140" Height="850" MinWidth="900" MinHeight="740" WindowStartupLocation="CenterScreen" Background="#0B1220" FontFamily="Segoe UI" FontSize="14" Foreground="#F0F4FA">
  <Grid Margin="30,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="ninmagic" FontSize="30" FontWeight="Bold"/><TextBlock Text="–nx" FontSize="30" FontWeight="Light" Foreground="{StaticResource Accent}"/></StackPanel><TextBlock Text="Tu consola, con espacio para más." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="#19392F" CornerRadius="12" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="MICROSD → PC → MICROSD" FontSize="11" Foreground="{StaticResource Accent}" FontWeight="Bold"/></Border>
    </Grid>
    <Border x:Name="AdminBanner" Grid.Row="1" Background="#332B20" CornerRadius="8" Padding="14" Margin="0,0,0,18">
      <DockPanel><Button x:Name="AdminButton" DockPanel.Dock="Right" Content="Abrir como administrador" Click="Elevate_Click" Padding="12,7" Margin="15,0,0,0"/><TextBlock Text="Para leer y preparar tarjetas se necesitan permisos de administrador." VerticalAlignment="Center" Foreground="#F7D99D"/></DockPanel>
    </Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="22">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="MÁS CAPACIDAD.&#x0a;LOS MISMOS DATOS." FontWeight="Bold" FontSize="21" LineHeight="29" Margin="0,0,0,25"/>
          <TextBlock Text="01  Guarda tu tarjeta" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Conecta la microSD original. Guarda una copia completa en un disco del PC." Margin="0,7,0,22" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="02  Restaura en la nueva" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Conecta la microSD nueva. Se prepararán sus particiones y se restaurarán tus datos. Su contenido anterior se borrará." Margin="0,7,0,22" Foreground="{StaticResource Muted}"/>
          <TextBlock Text="03  Comprueba y juega" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock Text="Se verifican los archivos y la emuMMC. Conserva la original hasta probar la nueva en la consola." Margin="0,7,0,25" Foreground="{StaticResource Muted}"/>
          <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,1,0,0" Padding="0,18,0,0"><TextBlock Text="Windows 10/11 · 64 bits&#x0a;FAT32 y exFAT · MBR&#x0a;Lector USB / SD / MMC" FontSize="12" Foreground="{StaticResource Muted}"/></Border>
        </StackPanel></ScrollViewer>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="25">
        <DockPanel LastChildFill="True">
          <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button x:Name="ActionButton" Content="Crear y verificar copia" Style="{StaticResource Primary}" Click="Action_Click" HorizontalAlignment="Left" MinWidth="240"/>
            <Button x:Name="VerifyButton" Content="Comprobar una copia sin restaurar" Click="Verify_Click" HorizontalAlignment="Left" Background="Transparent" Padding="0,14,0,0" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
          </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <UniformGrid x:Name="ModeButtons" Columns="2" Margin="0,0,0,24"><Button x:Name="BackupTab" Content="1. Crear copia" Click="BackupTab_Click" Margin="0,0,6,0" Style="{StaticResource Primary}"/><Button x:Name="RestoreTab" Content="2. Restaurar en otra SD" Click="RestoreTab_Click" Margin="6,0,0,0"/></UniformGrid>
          <TextBlock x:Name="SectionTitle" Text="Guarda todo antes de empezar" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="SectionDescription" Text="La copia incluye archivos visibles, ocultos y las particiones emuMMC compatibles. La tarjeta original se abre solo para lectura." Margin="0,9,0,22" Foreground="{StaticResource Muted}"/>
          <StackPanel x:Name="Inputs">
            <TextBlock x:Name="DiskLabel" Text="MICROSD ORIGINAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <DockPanel><Button Content="Actualizar" DockPanel.Dock="Right" Click="Refresh_Click" Margin="10,0,0,0" Padding="12,9"/><ComboBox x:Name="DiskCombo" MinHeight="40" AutomationProperties.Name="Tarjeta microSD" SelectionChanged="DiskCombo_SelectionChanged"/></DockPanel>
            <TextBlock x:Name="DiskDetails" Text="Conecta una microSD y pulsa Actualizar." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,22"/>
            <TextBlock x:Name="FolderLabel" Text="CARPETA PARA LA COPIA EN EL PC" FontSize="11" FontWeight="Bold" Foreground="{StaticResource Muted}" Margin="0,0,0,8"/>
            <DockPanel><Button Content="Elegir…" DockPanel.Dock="Right" Click="Browse_Click" Margin="10,0,0,0" Padding="14,9"/><TextBox x:Name="FolderText" MinHeight="40" AutomationProperties.Name="Carpeta de copia" TextChanged="FolderText_TextChanged"/></DockPanel>
            <TextBlock x:Name="FolderHint" Text="Necesitas espacio para los archivos y la emuMMC. Se creará una carpeta nueva dentro de la elegida." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,22"/>
          </StackPanel>
          <Border Background="#0D192A" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,18"><TextBlock x:Name="Summary" Text="La copia se comprueba con SHA-256 antes de poder restaurarla. Puedes usar un solo lector." Foreground="#C5D8ED"/></Border>
        </StackPanel></ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource Surface}" CornerRadius="10" Padding="18,14" Margin="0,20,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock x:Name="StatusText" Text="Listo para empezar" FontWeight="SemiBold"/><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Height="5" Margin="0,10,0,8" Foreground="{StaticResource Accent}" Background="#26374C" BorderThickness="0"/><TextBlock x:Name="ProgressDetail" Text="Apaga completamente la consola antes de retirar su microSD." Foreground="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Cancelar" Click="Cancel_Click" IsEnabled="False" VerticalAlignment="Center" Margin="20,0,0,0"/>
      </Grid>
    </Border>
    <DockPanel Grid.Row="4" Margin="2,13,2,0"><Button Content="Ayuda y compatibilidad" Click="Help_Click" Background="Transparent" Foreground="{StaticResource Muted}" Padding="0" FontSize="12" DockPanel.Dock="Left"/><Button Content="Abrir registros" Click="Logs_Click" Background="Transparent" Foreground="{StaticResource Muted}" Padding="15,0,0,0" FontSize="12" DockPanel.Dock="Right"/><TextBlock Text="1.2.0 · Datos copiados verificados" FontSize="12" Foreground="#798BA3" HorizontalAlignment="Right"/></DockPanel>
  </Grid>
</Window>
